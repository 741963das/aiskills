# ============================================================
# AI Skills Platform - 生产环境变量示例
# 部署路径：复制为 backend/.env 并填写真实值
#   cp deploy/.env.production backend/.env
# ============================================================

# ---------- 数据库 ----------
# SQLite（默认，单机够用）
DATABASE_URL=sqlite:///./app.db
# 生产高可用可换 PostgreSQL（需安装 psycopg2-binary）：
# DATABASE_URL=postgresql://user:password@localhost:5432/aiskills

# ---------- 认证安全（必改！） ----------
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
ALGORITHM=HS256
# 生产建议缩短 token 有效期（默认 1440 分钟 = 24h）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS（必改！改成正式域名） ----------
# 逗号分隔，不带结尾斜杠
CORS_ORIGINS=https://your-domain.com,http://your-domain.com

# ---------- 文件存储（建议用绝对路径） ----------
UPLOAD_DIR=/var/www/aiskills/backend/uploads
OUTPUT_DIR=/var/www/aiskills/backend/outputs

# ---------- Chroma 向量数据库 ----------
CHROMA_PERSIST_DIR=/var/www/aiskills/backend/chroma_data

# ---------- SiliconFlow API（大模型服务） ----------
SILICONFLOW_API_KEY=REPLACE_WITH_YOUR_KEY
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
CHAT_MODEL=deepseek-ai/DeepSeek-V3.2

# ---------- 启动清理（生产保持 false） ----------
CLEANUP_TEST_DATA_ON_START=false